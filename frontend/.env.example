# Frontend environment — copy to .env.local and adjust if needed.
# These values must match the backend JARVIS_ settings.

# Base URL for the JARVIS backend API.
# Leave empty to use the Vite dev proxy (default for local development).
VITE_API_BASE_URL=

# Must match JARVIS_MAX_CONTEXT_TOKENS in the backend .env.
# Used to render the context usage bar in the chat UI.
VITE_MAX_CONTEXT_TOKENS=8192
