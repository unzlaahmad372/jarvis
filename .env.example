# JARVIS Configuration — copy to .env and fill in values
# Never commit .env to Git

# ── LLM ──────────────────────────────────────────────────────────────────────
JARVIS_LLM_PROVIDER=ollama
JARVIS_LLM_MODEL=llama3.2
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_ALLOW_CLOUD=false

# ── Embedding (Phase 2) ───────────────────────────────────────────────────────
JARVIS_EMBEDDING_MODEL=nomic-embed-text

# ── Context / token budgets ───────────────────────────────────────────────────
JARVIS_MAX_CONTEXT_TOKENS=8192
JARVIS_MAX_RESPONSE_TOKENS=2048
JARVIS_RECENT_HISTORY_TOKENS=2048
JARVIS_RAG_CONTEXT_TOKENS=3072
JARVIS_MEMORY_CONTEXT_TOKENS=512

# ── Inference guardrails ──────────────────────────────────────────────────────
JARVIS_MAX_CONCURRENT_LLM_REQUESTS=2
JARVIS_LLM_REQUEST_TIMEOUT=120
JARVIS_MAX_QUEUE_LENGTH=10
JARVIS_MAX_TOOL_OUTPUT_SIZE=16384
JARVIS_MAX_RAG_CHUNKS=10

# ── Data ──────────────────────────────────────────────────────────────────────
JARVIS_DATA_DIR=./data
JARVIS_DATABASE_URL=sqlite+aiosqlite:///./data/database/jarvis.db

# ── Server ────────────────────────────────────────────────────────────────────
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
JARVIS_LOG_LEVEL=INFO

# ── Runtime ───────────────────────────────────────────────────────────────────
JARVIS_RUNTIME_MODE=native

# ── Safety ───────────────────────────────────────────────────────────────────
JARVIS_REQUIRE_CONFIRMATION=true

# ── Retention ────────────────────────────────────────────────────────────────
JARVIS_CONVERSATION_RETENTION_DAYS=365
JARVIS_TOOL_LOG_RETENTION_DAYS=90
JARVIS_TEMP_RETENTION_HOURS=24

# ── Feature flags (all off by default) ───────────────────────────────────────
JARVIS_ENABLE_CLOUD=false
JARVIS_ENABLE_SHELL=false
JARVIS_ENABLE_K8S_WRITE=false
JARVIS_ENABLE_REMOTE_ACCESS=false
JARVIS_ENABLE_ALWAYS_LISTENING=false
JARVIS_INBOX_WATCHER_ENABLED=false
